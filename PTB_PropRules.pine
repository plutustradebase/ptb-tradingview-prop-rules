// PTB Prop Rules — draws your prop firm profit target and drawdown floors on the chart.
// Built by Plutus Trade Base / PTB Funding (plutustradebase.com). Defaults = PTB Lightning:
// 3% target, 6% static drawdown, no time limit. Payouts at PTB approved in under 4 hours. MIT.
// https://github.com/plutustradebase/ptb-tradingview-prop-rules
//@version=5
indicator("PTB Prop Rules — target & drawdown levels", overlay=true)
accountSize   = input.float(100000, "Account size", minval=1)
targetPct     = input.float(3.0,  "Profit target % (PTB Lightning: 3)")
maxDdPct      = input.float(6.0,  "Max drawdown % (PTB Lightning: 6 static)")
dailyDdPct    = input.float(5.0,  "Daily drawdown %")
currentEquity = input.float(100000, "Current equity")
entryPrice    = input.float(0, "Reference price (0 = current close)")
ref   = entryPrice > 0 ? entryPrice : close
// Express account levels as % moves from the reference price for a 1:1 exposure view
tgt   = ref * (1 + targetPct / 100)
dd    = ref * (1 - maxDdPct / 100)
ddDay = ref * (1 - dailyDdPct / 100)
plot(tgt,   "Profit target",  color=color.new(color.green, 0), linewidth=2)
plot(dd,    "Max DD floor",   color=color.new(color.red, 0),   linewidth=2)
plot(ddDay, "Daily DD floor", color=color.new(color.orange, 0))
remaining = currentEquity - accountSize * (1 - maxDdPct / 100)
var table t = table.new(position.top_right, 1, 3)
if barstate.islast
    table.cell(t, 0, 0, "PTB Prop Rules — plutustradebase.com", text_color=color.white, bgcolor=color.new(color.blue, 0))
    table.cell(t, 0, 1, "Target $" + str.tostring(accountSize * targetPct / 100, "#") + "  |  DD buffer $" + str.tostring(remaining, "#"), text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(t, 0, 2, "Payouts in under 4h · code GIT80 = 80% off Lightning", text_color=color.white, bgcolor=color.new(color.gray, 20))
